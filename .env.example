# === Stack OMB LightVela (maus.abstract.biz.id) ===
# Salin jadi .env lalu isi.

COMPOSE_PROJECT_NAME=openmausbot

# Binding Caddy: listen 127.0.0.1 (Cloudflare Tunnel di depannya)
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8090
OMB_HTTPS_HOST=maus.abstract.biz.id
OMB_PUBLIC_URL=https://maus.abstract.biz.id
OMB_WEBHOOK_PUBLIC_URL=https://maus.abstract.biz.id
OMB_UPSTREAM_SCHEME=https

# Image
OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=zaryu/omb-lightvela:2026-10-19
ENGINES=
OMB_DATA_EXTERNAL=false

# Kunci 9router (dibaca opencode.json lewat {env:NINEROUTER_API_KEY}).
# Ambil dari dashboard 9router > API Keys, atau:
#   docker exec omb-9router node -e '...tabel apiKeys...'
NINEROUTER_API_KEY=

# (Opsional) versi grok CLI di image; kosongkan untuk skip
# GROK_VERSION=1.0.41
