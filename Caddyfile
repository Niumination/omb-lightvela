:80 {
	encode zstd gzip
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -Forwarded
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8799 {
			flush_interval -1
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -Forwarded
			header_up X-Forwarded-Proto https
		}
	}
}
